# Shared, hand-maintained source selection for the GNU Make build.
# Keep in sync with the libretro target when importing upstream changes.
SOURCES_C += libretro/core_mpsc_records.c libretro/core_disc.c libretro/core_vblank.c libretro/core_state_control.c libretro/core_socket_worker.c libretro/core_fiber_context.c libretro/core_events.c libretro/core_audio_cadence.c libretro/core_audio_samples.c libretro/core_audio_queue.c libretro/core_apu_clients.c libretro/core_audio_convert.c libretro/core_input_analog.c libretro/core_ui_queue.c libretro/core_decompress.c libretro/core_image.c libretro/core_file.c libretro/core_content_extract.c libretro/core_cache_file.c libretro/core_zarchive.c libretro/core_xex_metadata.c libretro/core_crypto.c libretro/core_guest_hash.c libretro/core_xlast.c
CORE_DIRS := src/xenia src/xenia/base src/xenia/apu src/xenia/apu/nop \
 src/xenia/cpu src/xenia/cpu/backend src/xenia/cpu/compiler \
 src/xenia/cpu/compiler/passes src/xenia/cpu/hir src/xenia/cpu/ppc \
 src/xenia/gpu src/xenia/gpu/null src/xenia/gpu/vulkan \
 src/xenia/hid src/xenia/hid/nop \
 src/xenia/ui src/xenia/ui/vulkan src/xenia/ui/vulkan/functions
CORE_DIRS += $(shell find src/xenia/kernel src/xenia/patcher src/xenia/vfs -type d)
ifeq ($(ARCH),aarch64)
CORE_DIRS += src/xenia/cpu/backend/a64
ARCH_SUFFIXES := arm64
CAPSTONE_ARCH := AArch64
CAPSTONE_DEFS := -DCAPSTONE_HAS_ARM64 -DCAPSTONE_HAS_AARCH64
else
CORE_DIRS += src/xenia/cpu/backend/x64
ARCH_SUFFIXES := amd64 x64
CAPSTONE_ARCH := X86
CAPSTONE_DEFS := -DCAPSTONE_HAS_X86 -DCAPSTONE_X86_ATT_DISABLE
endif
ifeq ($(OS),windows)
SOURCES_C += libretro/core_d3d12_fence.c libretro/core_d3d12_video.c
CORE_DIRS += src/xenia/gpu/d3d12 src/xenia/ui/d3d12
OS_SUFFIXES := win
else ifeq ($(OS),macos)
OS_SUFFIXES := posix mac
else ifeq ($(OS),android)
OS_SUFFIXES := posix linux android
else
OS_SUFFIXES := posix linux gnulinux x11 gtk
endif
ALL_CORE_SOURCES := $(foreach dir,$(CORE_DIRS),$(wildcard $(dir)/*.cc))
PLATFORM_SUFFIXES := win linux posix gnulinux x11 gtk android mac amd64 x64 arm64
SOURCES_CXX := $(filter-out $(foreach s,$(PLATFORM_SUFFIXES),%_$(s).cc),$(ALL_CORE_SOURCES))
SOURCES_CXX += $(filter $(foreach s,$(OS_SUFFIXES) $(ARCH_SUFFIXES),%_$(s).cc),$(ALL_CORE_SOURCES))
SOURCES_CXX := $(filter-out %_main.cc %_test.cc %_demo.cc \
 src/xenia/base/console_app_main_%.cc src/xenia/base/main_init_%.cc,$(SOURCES_CXX))
SOURCES_CXX += libretro/libretro.cpp libretro/libretro_audio_driver.cc \
 libretro/libretro_graphics_system.cc \
 libretro/libretro_hid.cc libretro/libretro_vk_presenter.cc \
 libretro/libretro_gamedb.cc src/xenia/hid/portal/portal.cc
ifeq ($(OS),windows)
SOURCES_C += src/xenia/ui/d3d12/d3d12_struct_return.c
SOURCES_C += $(wildcard src/xenia/gpu/dxil/*.c src/xenia/gpu/dxil/bytecode/*.c)
SOURCES_CXX += libretro/libretro_d3d12_presenter.cc third_party/dxbc/DXBCChecksum.cpp \
 src/xenia/hid/portal/hardware_portal.cc
SOURCES_C += third_party/libusb/libusb/core.c third_party/libusb/libusb/descriptor.c \
 third_party/libusb/libusb/hotplug.c third_party/libusb/libusb/io.c \
 third_party/libusb/libusb/strerror.c third_party/libusb/libusb/sync.c \
 third_party/libusb/libusb/os/events_windows.c third_party/libusb/libusb/os/threads_windows.c \
 third_party/libusb/libusb/os/windows_common.c third_party/libusb/libusb/os/windows_usbdk.c \
 third_party/libusb/libusb/os/windows_winusb.c
endif

INCLUDE_DIRS := $(GEN) $(GEN)/generated \
 . src libretro third_party third_party/capstone/include third_party/fmt/include \
 third_party/stb \
 third_party/libretro-common/include third_party/mspack \
 third_party/asio/include third_party/tomlplusplus/include third_party/llvm/include \
 third_party/Vulkan-Headers/include third_party/aes_128 \
 third_party/zarchive/include

SOURCES_C += third_party/aes_128/unroll/aes.c \
 third_party/mspack/lzxd.c third_party/mspack/system.c \
 third_party/capstone/cs.c third_party/capstone/MCInst.c \
 third_party/capstone/MCInstPrinter.c third_party/capstone/MCInstrDesc.c \
 third_party/capstone/MCRegisterInfo.c third_party/capstone/SStream.c \
 third_party/capstone/utils.c third_party/capstone/Mapping.c
SOURCES_C += $(filter-out %/X86ATTInstPrinter.c,$(wildcard third_party/capstone/arch/$(CAPSTONE_ARCH)/*.c))
SOURCES_CXX += third_party/fmt/src/format.cc third_party/fmt/src/os.cc \
 third_party/mspack/logging.cc \
 third_party/zarchive/src/zarchivewriter.cpp
SOURCES_CXX += $(wildcard src/xenia/gpu/spirv/*.cpp)

SOURCES_ASM :=
ifeq ($(ARCH),aarch64)
SOURCES_CXX += third_party/xbyak_aarch64/src/xbyak_aarch64_impl.cpp \
 third_party/xbyak_aarch64/src/util_impl.cpp
INCLUDE_DIRS += third_party/xbyak_aarch64 third_party/xbyak_aarch64/src \
 third_party/xbyak_aarch64/xbyak_aarch64
endif

# Built-in shaders are checked-in raw SPIR-V and DXIL modules. The C89
# generator only embeds bytes; no shader language compiler runs during a build.
SHADER_SOURCES := $(wildcard src/xenia/gpu/shaders/bytecode/vulkan_spirv/*.spv)
ifeq ($(OS),windows)
SHADER_SOURCES += $(wildcard src/xenia/gpu/shaders/bytecode/d3d12_dxil/*.dxil)
endif
shader-output = $(GEN)/generated/$(patsubst src/%,%,$(basename $(1))).h
SHADER_HEADERS := $(foreach s,$(SHADER_SOURCES),$(call shader-output,$(s)))
SOURCES_CXX += $(GEN)/embedded_bundle_patches.cc $(GEN)/libretro_gamedb_data.cc

# Optional offline comparison archive; production uses native codecs.
FFMPEG_REFERENCE ?= 0
ifeq ($(FFMPEG_REFERENCE),1)
INCLUDE_DIRS += third_party/ffmpeg-xenia third_party/FFmpeg
# FFmpeg: the same fixed codec/container subset as the existing core.
