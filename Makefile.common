SOURCES_C += libretro/core_xma_native.c third_party/libretro-common/formats/wma/rwma_pro.c third_party/libretro-common/formats/wma/rwma_standard.c

SOURCES_C += libretro/core_media_audio.c third_party/libretro-common/formats/audio_transfer.c \
 third_party/libretro-common/formats/data_transfer.c third_party/libretro-common/formats/mp3/rmp3.c \
 third_party/libretro-common/formats/wma/rwma_stream.c third_party/libretro-common/memmap/memmap.c
$(BUILD_DIR)/obj/third_party/libretro-common/formats/audio_transfer.c.o: CPPFLAGS += -DHAVE_RMP3 -DHAVE_RWMA
